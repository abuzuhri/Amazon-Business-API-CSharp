    <OpenApiReference Include="OpenAPIs\UserManagement_API.json" CodeGenerator="NSwagCSharp" Namespace="CSharpAmazonBusinessAPI.Model.UserManagement" Options="/UseBaseUrl:false /GenerateClientInterfaces:false /GenerateExceptionClasses:true /AdditionalNamespaceUsages:CSharpAmazonBusinessAPI.Exceptions" ClassName="UserManagementApiV1" OutputPath="UserManagementApiV1.cs">
